#!/usr/bin/env bash
set -e
if [[ ! -d "/home/cody-ai/p/local-rcu" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/cody-ai/p/local-rcu")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/cody-ai/p/local-rcu" true
